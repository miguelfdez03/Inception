# Domain configuration (e.g. login.42.fr)
DOMAIN_NAME=

# System user for volumes (/home/${USER}/data/...)
USER=

# MariaDB credentials
DB_NAME=
DB_USER=
DB_USER_PASS=
DB_ROOT_PASS=

# WordPress credentials
# WARNING: WP_ADMIN must NOT contain 'admin' or 'Admin' (Scale requirement)
WP_ADMIN=
WP_ADMIN_PASS=
WP_USER=
WP_USER_PASS=
